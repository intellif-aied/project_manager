{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "daily-report-evaluation-dataset/v2",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "file_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "evidence_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "disposition", "statement", "source_refs", "state", "environment"],
      "properties": {
        "evidence_id": { "type": "string", "minLength": 1 },
        "disposition": { "enum": ["required", "optional", "exclude"] },
        "statement": { "type": "string", "minLength": 1 },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "state": { "enum": ["released", "validated", "completed", "in_progress", "blocked", "none"] },
        "environment": { "enum": ["production", "test", "development", "none"] }
      }
    },
    "topic_relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation", "evidence_refs"],
      "properties": {
        "relation": { "enum": ["same_workstream", "separate_workstream"] },
        "evidence_refs": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "evidence_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "items", "topic_relations", "forbidden_additions", "no_reportable_work"],
      "properties": {
        "schema_version": { "const": "daily-report-evidence-baseline/v1" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_item" }
        },
        "topic_relations": {
          "type": "array",
          "items": { "$ref": "#/$defs/topic_relation" }
        },
        "forbidden_additions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "no_reportable_work": { "type": "boolean" }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_version", "rubric_version", "report_type", "pattern_baseline", "cases"],
  "properties": {
    "schema_version": { "const": "daily-report-evaluation-dataset/v2" },
    "dataset_version": { "type": "string", "minLength": 1 },
    "rubric_version": { "type": "string", "minLength": 1 },
    "report_type": { "const": "personal_daily" },
    "pattern_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_version", "statistics"],
      "properties": {
        "dataset_version": { "type": "string", "minLength": 1 },
        "statistics": { "$ref": "#/$defs/file_reference" }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "report_date", "selected_session_slice_keys", "source_evidence", "evidence_baseline", "tags", "source", "usage_authorized"],
        "properties": {
          "case_id": { "type": "string", "minLength": 1 },
          "report_date": { "type": "string", "format": "date" },
          "selected_session_slice_keys": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "format": "uuid" }
          },
          "source_evidence": { "$ref": "#/$defs/file_reference" },
          "evidence_baseline": { "$ref": "#/$defs/evidence_baseline" },
          "tags": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "source": { "type": "string", "minLength": 1 },
          "usage_authorized": { "const": true }
        }
      }
    }
  }
}
