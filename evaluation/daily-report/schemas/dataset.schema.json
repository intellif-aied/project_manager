{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "daily-report-evaluation-dataset/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_version", "rubric_version", "report_type", "cases"],
  "properties": {
    "schema_version": { "const": "daily-report-evaluation-dataset/v1" },
    "dataset_version": { "type": "string", "minLength": 1 },
    "rubric_version": { "type": "string", "minLength": 1 },
    "report_type": { "const": "personal_daily" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "report_date", "selected_session_slice_keys", "evidence_baseline", "tags", "source", "usage_authorized"],
        "properties": {
          "case_id": { "type": "string", "minLength": 1 },
          "report_date": { "type": "string", "format": "date" },
          "selected_session_slice_keys": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "format": "uuid" } },
          "expected_source_identity_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "evidence_baseline": { "type": "object" },
          "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "source": { "type": "string", "minLength": 1 },
          "usage_authorized": { "const": true }
        }
      }
    }
  }
}
