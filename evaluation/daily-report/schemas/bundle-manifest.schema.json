{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "daily-report-evaluation-bundle/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_version", "dataset_sha256", "rubric_version", "created_at", "variants", "runs"],
  "properties": {
    "schema_version": { "const": "daily-report-evaluation-bundle/v1" },
    "dataset_version": { "type": "string", "minLength": 1 },
    "dataset_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "rubric_version": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "variants": { "$ref": "execution-plan.schema.json#/$defs/variants" },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "variant_version", "repetition", "run_id", "status", "variant_sha256"],
        "properties": {
          "case_id": { "type": "string" },
          "variant_version": { "type": "string" },
          "repetition": { "type": "integer", "minimum": 1 },
          "run_id": { "type": "string", "format": "uuid" },
          "status": { "enum": ["succeeded", "failed", "timeout"] },
          "failure_stage": { "type": "string" },
          "error_code": { "type": "string" },
          "variant_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "artifact_sha256": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
        }
      }
    }
  }
}
